IRON_AGENT_ENV=development
IRON_AGENT_HOST=0.0.0.0
IRON_AGENT_PORT=8000
IRON_AGENT_LOG_LEVEL=INFO
IRON_AGENT_STORAGE_BACKEND=mysql

# 【重要】容器内进程用户配置
# 确保容器内创建的文件/目录属于宿主机用户，避免权限问题
# Linux/macOS 可通过 id 命令查看当前用户的 UID 和 GID
# 示例：uid=1000(junbo) gid=1000(junbo) groups=1000(junbo)
HOST_UID=1000
HOST_GID=1000

# 新部署优先填写 IRON_AGENT_*；IRON_AGENT_* 是当前唯一配置前缀。
# 全 Docker 部署建议填写这几个绝对路径。
# macOS / Linux 示例：
# IRON_AGENT_STACK_ROOT=/Users/yourname/work/ironagent
# IRON_AGENT_RUNTIME_SOURCE_ROOT=/Users/yourname/work/ironagent-main
# IRON_AGENT_HOST_IRON_AGENT_ROOT=/Users/yourname/.ironagent
#
# Windows 建议使用 WSL2 路径进行全 Docker 部署，例如：
# IRON_AGENT_STACK_ROOT=/home/yourname/work/ironagent
# IRON_AGENT_RUNTIME_SOURCE_ROOT=/home/yourname/work/ironagent-main
# IRON_AGENT_HOST_IRON_AGENT_ROOT=/home/yourname/.ironagent
IRON_AGENT_STACK_ROOT=
IRON_AGENT_RUNTIME_SOURCE_ROOT=
IRON_AGENT_HOST_IRON_AGENT_ROOT=
# 如果 /var/run/docker.sock 的 group id 不是 999，请改成宿主机实际 gid。
IRON_AGENT_DOCKER_SOCKET_GID=1001
IRON_AGENT_SECURITY_SERVICE_PORT=8000
IRON_AGENT_ADMIN_PORT=8501
IRON_AGENT_MARKET_STORE_PATH=
IRON_AGENT_MARKET_PACKAGE_ROOT=
IRON_AGENT_MARKET_UPLOAD_ROOT=

# 可选：为 Streamlit Assistants 页面增加额外可选的公共工作空间根目录。
# 推荐把这些目录建在 IRON_AGENT_STACK_ROOT 之下；如果目录在仓库外，需要把同一路径额外挂载进
# security-service 和 admin 容器，否则 Docker 控制面无法在容器内访问该目录。
# 示例：
# IRON_AGENT_ALLOWED_WORKSPACE_ROOTS_JSON=[{"id":"team-a","label":"团队A工作空间","host_path":"/Users/yourname/work/ironagent/data/workspaces-team-a"}]
IRON_AGENT_ALLOWED_WORKSPACE_ROOTS_JSON=
IRON_AGENT_DEFAULT_WORKSPACE_ROOT_ID=default

IRON_AGENT_CONFIG_DIR=./config
IRON_AGENT_AUDIT_LOG_PATH=./data/audit/audit.jsonl
IRON_AGENT_ASSISTANTS_STORE_PATH=./data/assistants/assistants.json
IRON_AGENT_APPROVAL_STORE_PATH=./data/approvals/approvals.json
IRON_AGENT_APPROVAL_TIMEOUT_MINUTES=15
# 运行时可以直接连接共享 / 线上 MySQL。
# 但不要把 pytest 指到共享库，因为集成与文件流转用例会写入、覆盖和删除数据。
# 如果要让 admin / security-service 使用线上库，优先复制 `.env.live-db.example`
# 中的连接串覆盖这里的值。
IRON_AGENT_DATABASE_URL=mysql+pymysql://username:password@host:3306/ironagent?charset=utf8mb4
IRON_AGENT_WORKSPACE_OBJECT_STORAGE_BACKEND=local
IRON_AGENT_WORKSPACE_FILE_METADATA_BACKEND=
IRON_AGENT_WORKSPACE_FILE_SQLITE_PATH=./data/workspace.db
IRON_AGENT_WORKSPACE_FILE_SQLITE_BUSY_TIMEOUT_MS=30000
IRON_AGENT_WORKSPACE_FILE_SQLITE_CACHE_SIZE_MB=64
IRON_AGENT_WORKSPACE_FILE_SQLITE_WAL_AUTOCHECKPOINT=1000
IRON_AGENT_RUNTIME_WORKSPACE_FILE_SQLITE_MOUNT_PATH=/home/node/.ironagent/workspace-metadata
IRON_AGENT_WORKSPACE_OBJECT_STORAGE_PREFIX=heinu/workspace-files
IRON_AGENT_WORKSPACE_OBJECT_STORAGE_ROOT=./data/workspace_objects
IRON_AGENT_WORKSPACE_OBJECT_STORAGE_PREFIX=workspace-files
IRON_AGENT_WORKSPACE_RESULT_SCAN_ENABLED=false
IRON_AGENT_WORKSPACE_RESULT_SCAN_INTERVAL_SECONDS=10
IRON_AGENT_COS_SECRET_ID=
IRON_AGENT_COS_SECRET_KEY=
IRON_AGENT_COS_SESSION_TOKEN=
IRON_AGENT_COS_BUCKET=<bucket-name>
IRON_AGENT_COS_REGION=<region>
IRON_AGENT_COS_ENDPOINT=https://<bucket-name>.cos.<region>.myqcloud.com
IRON_AGENT_COS_PREFIX=
IRON_AGENT_OBS_ACCESS_KEY_ID=
IRON_AGENT_OBS_SECRET_ACCESS_KEY=
IRON_AGENT_OBS_BUCKET=
IRON_AGENT_OBS_ENDPOINT=
IRON_AGENT_OBS_PREFIX=

# 协作对象存储配置。
# 示例：
# IRON_AGENT_COLLABORATION_OBJECT_STORAGE_BACKEND=cos
# IRON_AGENT_COLLABORATION_OBJECT_STORAGE_BUCKET=example-bucket
# IRON_AGENT_COLLABORATION_OBJECT_STORAGE_REGION=ap-shanghai
# IRON_AGENT_COLLABORATION_OBJECT_STORAGE_ENDPOINT=https://example-bucket.cos.ap-shanghai.myqcloud.com
# IRON_AGENT_COLLABORATION_OBJECT_STORAGE_PREFIX=heinu/
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_BACKEND=cos
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_BUCKET=
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_REGION=
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_ENDPOINT=
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_PREFIX=heinu/

IRON_AGENT_RUNTIME_SERVICE_URL=http://localhost:3000
IRON_AGENT_RUNTIME_HOOK_SERVICE_URL=http://host.docker.internal:8000
IRON_AGENT_RUNTIME_CONTAINER_EXTRA_HOST=host.docker.internal:host-gateway
IRON_AGENT_RUNTIME_SEED_WORKSPACE_SKILLS=office-docs,local-pdf
# 如果宿主机必须依赖代理/VPN 才能访问外部模型，请把代理转发给助手容器。
# 本地代理通常不要填 127.0.0.1:7890，而要填 host.docker.internal:7890。
# 示例：
# IRON_AGENT_RUNTIME_HTTP_PROXY=http://host.docker.internal:7890
# IRON_AGENT_RUNTIME_HTTPS_PROXY=http://host.docker.internal:7890
# IRON_AGENT_RUNTIME_NO_PROXY=localhost,127.0.0.1,host.docker.internal
IRON_AGENT_RUNTIME_HTTP_PROXY=
IRON_AGENT_RUNTIME_HTTPS_PROXY=
IRON_AGENT_RUNTIME_NO_PROXY=
IRON_AGENT_HOOK_TIMEOUT_MS=5000

IRON_AGENT_ADMIN_TOKEN=change-me
