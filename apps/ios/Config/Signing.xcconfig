// Shared iOS signing defaults for local development + CI.
#include "Version.xcconfig"

IRONAGENT_IOS_DEFAULT_TEAM = Y5PE65HELJ
IRONAGENT_IOS_SELECTED_TEAM = $(IRONAGENT_IOS_DEFAULT_TEAM)
IRONAGENT_APP_BUNDLE_ID = ai.ironagent.client
IRONAGENT_WATCH_APP_BUNDLE_ID = ai.ironagent.client.watchkitapp
IRONAGENT_WATCH_EXTENSION_BUNDLE_ID = ai.ironagent.client.watchkitapp.extension
IRONAGENT_ACTIVITY_WIDGET_BUNDLE_ID = ai.ironagent.client.activitywidget

// Local contributors can override this by running scripts/ios-configure-signing.sh.
// Keep include after defaults: xcconfig is evaluated top-to-bottom.
#include? "../.local-signing.xcconfig"
#include? "../LocalSigning.xcconfig"

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = $(IRONAGENT_IOS_SELECTED_TEAM)

// Let Xcode manage provisioning for the selected local team.
PROVISIONING_PROFILE_SPECIFIER =
