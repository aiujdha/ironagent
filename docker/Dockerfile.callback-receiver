# 升级打包工具链、拷贝源码、创建运行用户(单阶段构建)
FROM python:3.11-slim

WORKDIR /app

# 固定升级 Python 打包工具链以修复 CVE：基础镜像自带的 pip / setuptools / wheel
# 版本过旧（setuptools 内置 vendored 的 jaraco.context 5.3.0 存在 CVE-2026-23949
# Zip Slip 路径遍历），升级到 pip 26.1.1 / setuptools 82.0.1 / wheel 0.47.0，并清除
# Debian dist-packages 中残留的旧版本（dpkg 记录 + dist-info），避免 OS 包扫描器
# 和 Python 包扫描器继续检出旧版本。
RUN pip install --no-cache-dir --upgrade \
    "pip==26.1.1" "setuptools==82.0.1" "wheel==0.47.0" \
    -i https://mirrors.cloud.tencent.com/pypi/simple \
    --trusted-host mirrors.cloud.tencent.com && \
    if command -v apt-get >/dev/null 2>&1; then apt-get purge -y python3-pip python3-setuptools python3-wheel || true; fi && \
    rm -rf /usr/lib/python3/dist-packages/pip* \
           /usr/lib/python3/dist-packages/setuptools* \
           /usr/lib/python3/dist-packages/wheel* \
           /usr/lib/python3/dist-packages/pkg_resources*

ENV PYTHONPATH=/app
COPY src/callback_receiver/receiver.py /app/receiver.py

ARG HOST_UID=1000
ARG HOST_GID=1000
RUN groupadd -g $HOST_GID appgroup && \
    useradd -m -u $HOST_UID -g $HOST_GID appuser && \
    chown -R appuser:appgroup /app

EXPOSE 8099

# 使用非 root 用户运行
USER appuser

CMD ["python", "/app/receiver.py"]
