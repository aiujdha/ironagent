# Runtime-only overlay for shared / live MySQL.
# Usage:
#   1. cp .env.example .env
#   2. copy the values below into .env
#   3. replace <user> and <password> with the real credentials
#
# Do not run pytest against the shared database. Several integration and
# workspace-file tests write, overwrite, and delete records.

IRON_AGENT_ENV=production
IRON_AGENT_STORAGE_BACKEND=mysql
IRON_AGENT_DATABASE_URL=mysql+pymysql://<user>:<password>@db.example.internal:22229/heinu?charset=utf8mb4
