FROM golang:1.25-alpine AS build

WORKDIR /src/go-gateway
ARG GOPROXY=https://goproxy.cn,direct
ARG TARGETOS
ARG TARGETARCH
ENV GOPROXY=${GOPROXY}

COPY go-gateway/go.mod go-gateway/go.sum ./
RUN go mod download

COPY go-gateway/ ./
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w" -o /out/go-gateway ./cmd/server && \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w" -o /out/p7tool ./cmd/p7tool

FROM alpine:3.22

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk add --no-cache ca-certificates tzdata && \
    addgroup -S gateway && \
    adduser -S -G gateway -u 10001 gateway

COPY --from=build /out/go-gateway /usr/local/bin/go-gateway.real
COPY --from=build /out/p7tool /usr/local/bin/p7tool

RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    ': "${GO_GATEWAY_TASK_WORKER_CONCURRENCY:=16}"' \
    ': "${GO_GATEWAY_TASK_WORKER_CLAIM_LIMIT:=1}"' \
    ': "${GO_GATEWAY_RUNTIME_EXECUTION_TIMEOUT:=10m}"' \
    ': "${GO_GATEWAY_TASK_WORKER_MAX_ATTEMPTS:=6}"' \
    ': "${GO_GATEWAY_TASK_WORKER_RETRY_DELAY:=75s}"' \
    ': "${GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_MAX_ATTEMPTS:=100}"' \
    ': "${GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_TIMEOUT:=30m}"' \
    ': "${GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_CALLBACK_INTERVAL:=5m}"' \
    ': "${GO_GATEWAY_TASK_WORKER_STALE_PROGRESS_TIMEOUT:=600s}"' \
    ': "${GO_GATEWAY_TASK_PROGRESS_CALLBACK_ENABLED:=true}"' \
    ': "${GO_GATEWAY_TASK_PROGRESS_CALLBACK_BATCH_SIZE:=5}"' \
    ': "${GO_GATEWAY_TASK_PROGRESS_CALLBACK_INTERVAL:=90s}"' \
    ': "${GO_GATEWAY_TASK_PROGRESS_CALLBACK_STEP_MAX_CHARS:=150}"' \
    ': "${GO_GATEWAY_TASK_PROGRESS_CALLBACK_STATE_TTL:=2h}"' \
    ': "${GO_GATEWAY_TASK_QUEUE_MAX_PENDING_PER_ASSISTANT:=20}"' \
    'export GO_GATEWAY_TASK_WORKER_CONCURRENCY' \
    'export GO_GATEWAY_TASK_WORKER_CLAIM_LIMIT' \
    'export GO_GATEWAY_RUNTIME_EXECUTION_TIMEOUT' \
    'export GO_GATEWAY_TASK_WORKER_MAX_ATTEMPTS' \
    'export GO_GATEWAY_TASK_WORKER_RETRY_DELAY' \
    'export GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_MAX_ATTEMPTS' \
    'export GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_TIMEOUT' \
    'export GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_CALLBACK_INTERVAL' \
    'export GO_GATEWAY_TASK_WORKER_STALE_PROGRESS_TIMEOUT' \
    'export GO_GATEWAY_TASK_PROGRESS_CALLBACK_ENABLED' \
    'export GO_GATEWAY_TASK_PROGRESS_CALLBACK_BATCH_SIZE' \
    'export GO_GATEWAY_TASK_PROGRESS_CALLBACK_INTERVAL' \
    'export GO_GATEWAY_TASK_PROGRESS_CALLBACK_STEP_MAX_CHARS' \
    'export GO_GATEWAY_TASK_PROGRESS_CALLBACK_STATE_TTL' \
    'export GO_GATEWAY_TASK_QUEUE_MAX_PENDING_PER_ASSISTANT' \
    'exec /usr/local/bin/go-gateway.real "$@"' \
    > /usr/local/bin/go-gateway && \
    chmod +x /usr/local/bin/go-gateway

ENV GO_GATEWAY_TASK_WORKER_CONCURRENCY=16 \
    GO_GATEWAY_TASK_WORKER_CLAIM_LIMIT=1 \
    GO_GATEWAY_RUNTIME_EXECUTION_TIMEOUT=10m \
    GO_GATEWAY_TASK_WORKER_MAX_ATTEMPTS=6 \
    GO_GATEWAY_TASK_WORKER_RETRY_DELAY=75s \
    GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_MAX_ATTEMPTS=100 \
    GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_TIMEOUT=30m \
    GO_GATEWAY_TASK_WORKER_CAPACITY_WAIT_CALLBACK_INTERVAL=5m \
    GO_GATEWAY_TASK_WORKER_STALE_PROGRESS_TIMEOUT=600s \
    GO_GATEWAY_TASK_PROGRESS_CALLBACK_ENABLED=true \
    GO_GATEWAY_TASK_PROGRESS_CALLBACK_BATCH_SIZE=5 \
    GO_GATEWAY_TASK_PROGRESS_CALLBACK_INTERVAL=90s \
    GO_GATEWAY_TASK_PROGRESS_CALLBACK_STEP_MAX_CHARS=150 \
    GO_GATEWAY_TASK_PROGRESS_CALLBACK_STATE_TTL=2h \
    GO_GATEWAY_TASK_QUEUE_MAX_PENDING_PER_ASSISTANT=20

USER 10001:10001
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/go-gateway"]
