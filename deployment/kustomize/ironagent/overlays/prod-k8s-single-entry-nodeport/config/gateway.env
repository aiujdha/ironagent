# Current live-compatible Gateway settings for single-entry K8s runtime validation.
HOME=/home/node
TERM=xterm-256color
TZ=UTC
IRON_AGENT_CONFIG_DIR=/app/ironagent/.ironagent
IRON_AGENT_GATEWAY_BIND=lan
IRON_AGENT_GATEWAY_PORT=18789
IRON_AGENT_GATEWAY_ALLOWED_ORIGINS=["http://192.0.2.10:30808","http://127.0.0.1:30808","http://localhost:30808"]
