# Example Gateway settings for a NodePort deployment.
HOME=/home/node
TERM=xterm-256color
TZ=UTC
IRONAGENT_CONFIG_DIR=/app/ironagent/.ironagent
IRONAGENT_GATEWAY_BIND=lan
IRONAGENT_GATEWAY_PORT=18789
IRONAGENT_GATEWAY_ALLOWED_ORIGINS=["http://192.0.2.10:30789","http://127.0.0.1:30789","http://localhost:30789"]
