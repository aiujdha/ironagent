# Non-secret control-plane settings matched to the current cluster layout.
IRON_AGENT_ENV=production
IRON_AGENT_LOG_LEVEL=INFO
IRON_AGENT_STORAGE_BACKEND=mysql
IRON_AGENT_CONFIG_DIR=/app/ironagent/ironagent-feat-hooks/config
IRON_AGENT_AUDIT_LOG_PATH=/app/ironagent/ironagent-feat-hooks/data/audit/audit.jsonl
IRON_AGENT_ASSISTANTS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/assistants/assistants.json
IRON_AGENT_APPROVAL_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/approvals/approvals.json
IRON_AGENT_APPROVAL_MODE=disabled
IRON_AGENT_ASSISTANTS_WORKSPACE_ROOT=/app/ironagent/ironagent-feat-hooks/data/workspaces
IRON_AGENT_ASSISTANTS_RUNTIME_ROOT=/app/ironagent/ironagent-feat-hooks/data/runtimes
IRON_AGENT_USERS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/users/users.json
IRON_AGENT_USER_BINDINGS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/users/bindings.json
IRON_AGENT_WORKSPACE_FILES_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/workspace_files/files.json
IRON_AGENT_WORKSPACE_FILE_EVENTS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/workspace_files/events.json
IRON_AGENT_WORKSPACE_FILE_METADATA_BACKEND=mysql
IRON_AGENT_WORKSPACE_FILE_SQLITE_PATH=/workspace-root/control-plane/data/workspace_files/workspace-files.sqlite
IRON_AGENT_WORKSPACE_ITEM_INDEX_SQLITE_PATH=/workspace-root/control-plane/data/workspace_files/workspace-item-index.sqlite
IRON_AGENT_WORKSPACE_PUSH_REQUESTS_STORE_PATH=/workspace-root/control-plane/data/workspace_files/push_requests.json
IRON_AGENT_MARKET_STORE_PATH=/workspace-root/control-plane/data/market/catalog.json
IRON_AGENT_MARKET_PACKAGE_ROOT=/workspace-root/control-plane/data/market/packages
IRON_AGENT_MARKET_UPLOAD_ROOT=/workspace-root/control-plane/data/market/uploads
IRON_AGENT_DEFAULT_WORKSPACE_ROOT_ID=default
IRON_AGENT_ALLOWED_WORKSPACE_ROOTS_JSON=
IRON_AGENT_HOST_IRON_AGENT_ROOT=/app/ironagent/.ironagent
IRON_AGENT_RUNTIME_SOURCE_ROOT=/app/ironagent
IRON_AGENT_RUNTIME_SEED_WORKSPACE_SKILLS=
IRON_AGENT_RUNTIME_CONTAINER_IMAGE=localhost/ironagent:rename-ironagent-760825ac
IRON_AGENT_DOCKER_BINARY=/app/ironagent/ironagent-feat-hooks/bin/ironagent-docker
IRON_AGENT_DOCKER_SOCKET_PATH=/run/containerd/containerd.sock
IRON_AGENT_RUNTIME_GATEWAY_HOST=0.0.0.0
IRON_AGENT_RUNTIME_GATEWAY_PUBLISH_HOST=0.0.0.0
IRON_AGENT_RUNTIME_GATEWAY_PUBLISH_PORT_START=49150
IRON_AGENT_RUNTIME_GATEWAY_PUBLISH_PORT_END=49249
IRON_AGENT_RUNTIME_HOOK_SERVICE_URL=http://security-service:8000
IRON_AGENT_RUNTIME_DNS_SERVERS=223.5.5.5,119.29.29.29
IRON_AGENT_RUNTIME_HTTP_PROXY=
IRON_AGENT_RUNTIME_HTTPS_PROXY=
IRON_AGENT_RUNTIME_NO_PROXY=localhost,127.0.0.1,192.0.2.10,192.0.2.11,security-service,admin,.svc,.cluster.local
IRON_AGENT_CONTROL_UI_PUBLIC_URL=http://192.0.2.10:30808
IRON_AGENT_CONTROL_UI_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^http://111\.229\.122\.155:30808$
IRON_AGENT_GO_GATEWAY_PUBLIC_URL=http://192.0.2.10:30808
IRON_AGENT_SECURITY_SERVICE_PUBLIC_URL=
IRON_AGENT_SECURITY_SERVICE_INTERNAL_URL=http://security-service:8000
IRON_AGENT_CONTROL_UI_LAUNCH_TICKET_TTL_SECONDS=600
IRON_AGENT_COS_BUCKET=example-bucket
IRON_AGENT_COS_REGION=ap-shanghai
IRON_AGENT_COS_ENDPOINT=https://object-storage.example.internal
IRON_AGENT_COS_PREFIX=heinu/
IRON_AGENT_WORKSPACE_OBJECT_STORAGE_BACKEND=cos
IRON_AGENT_WORKSPACE_OBJECT_STORAGE_PREFIX=heinu/workspace-files
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_BACKEND=cos
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_BUCKET=example-bucket
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_REGION=ap-shanghai
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_ENDPOINT=https://object-storage.example.internal
IRON_AGENT_COLLABORATION_OBJECT_STORAGE_PREFIX=heinu/
