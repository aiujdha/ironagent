IRONAGENT_ENV=production
IRONAGENT_LOG_LEVEL=INFO
IRONAGENT_STORAGE_BACKEND=mysql
IRONAGENT_CONFIG_DIR=/app/ironagent/ironagent-feat-hooks/config
IRONAGENT_AUDIT_LOG_PATH=/app/ironagent/ironagent-feat-hooks/data/audit/audit.jsonl
IRONAGENT_ASSISTANTS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/assistants/assistants.json
IRONAGENT_APPROVAL_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/approvals/approvals.json
IRONAGENT_ASSISTANTS_WORKSPACE_ROOT=/app/ironagent/ironagent-feat-hooks/data/workspaces
IRONAGENT_ASSISTANTS_RUNTIME_ROOT=/app/ironagent/ironagent-feat-hooks/data/runtimes
IRONAGENT_USERS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/users/users.json
IRONAGENT_USER_BINDINGS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/users/bindings.json
IRONAGENT_WORKSPACE_FILES_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/workspace_files/files.json
IRONAGENT_WORKSPACE_FILE_EVENTS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/workspace_files/events.json
IRONAGENT_WORKSPACE_PUSH_REQUESTS_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/workspace_files/push_requests.json
IRONAGENT_MARKET_STORE_PATH=/app/ironagent/ironagent-feat-hooks/data/market/catalog.json
