IRONAGENT_MARKET_UPLOAD_ROOT=/app/ironagent/ironagent-feat-hooks/data/market/uploads
IRONAGENT_DEFAULT_WORKSPACE_ROOT_ID=default
IRONAGENT_ALLOWED_WORKSPACE_ROOTS_JSON=
IRONAGENT_HOST_IRONAGENT_ROOT=/app/ironagent/.ironagent
IRONAGENT_IRONAGENT_SOURCE_ROOT=/app/ironagent
IRONAGENT_IRONAGENT_SEED_WORKSPACE_SKILLS=
IRONAGENT_IRONAGENT_CONTAINER_IMAGE=ironagent:feat-webui-a45afb5-hotfix3
IRONAGENT_DOCKER_BINARY=/app/ironagent/ironagent-feat-hooks/bin/ironagent-docker
IRONAGENT_DOCKER_SOCKET_PATH=/run/containerd/containerd.sock
IRONAGENT_IRONAGENT_GATEWAY_PUBLISH_HOST=0.0.0.0
IRONAGENT_IRONAGENT_GATEWAY_PUBLISH_PORT_START=49150
IRONAGENT_IRONAGENT_GATEWAY_PUBLISH_PORT_END=49249
IRONAGENT_IRONAGENT_HOOK_SERVICE_URL=http://security-service:8000
IRONAGENT_IRONAGENT_DNS_SERVERS=223.5.5.5,119.29.29.29
IRONAGENT_IRONAGENT_HTTP_PROXY=
IRONAGENT_IRONAGENT_HTTPS_PROXY=
IRONAGENT_IRONAGENT_NO_PROXY=localhost,127.0.0.1,security-service,admin,.svc,.cluster.local
IRONAGENT_CONTROL_UI_PUBLIC_URL=https://control.example.com
IRONAGENT_SECURITY_SERVICE_PUBLIC_URL=https://security.example.com
IRONAGENT_SECURITY_SERVICE_INTERNAL_URL=http://security-service:8000
IRONAGENT_CONTROL_UI_LAUNCH_TICKET_TTL_SECONDS=90
IRONAGENT_COS_BUCKET=ironagent-example
IRONAGENT_COS_REGION=ap-shanghai
IRONAGENT_COS_ENDPOINT=https://cos.example.invalid
IRONAGENT_COS_PREFIX=ironagent/
IRONAGENT_COLLABORATION_OBJECT_STORAGE_BACKEND=cos
IRONAGENT_COLLABORATION_OBJECT_STORAGE_BUCKET=ironagent-example
IRONAGENT_COLLABORATION_OBJECT_STORAGE_REGION=ap-shanghai
IRONAGENT_COLLABORATION_OBJECT_STORAGE_ENDPOINT=https://cos.example.invalid
IRONAGENT_COLLABORATION_OBJECT_STORAGE_PREFIX=ironagent/
