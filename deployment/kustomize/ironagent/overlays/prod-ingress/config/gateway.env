# Recommended remote-access settings: keep the Gateway behind HTTPS.
HOME=/home/node
TERM=xterm-256color
TZ=UTC
IRONAGENT_CONFIG_DIR=/app/ironagent/.ironagent
IRONAGENT_GATEWAY_BIND=lan
IRONAGENT_GATEWAY_PORT=18789
IRONAGENT_GATEWAY_ALLOWED_ORIGINS=["https://control.example.com","http://127.0.0.1:30789","http://localhost:30789"]
