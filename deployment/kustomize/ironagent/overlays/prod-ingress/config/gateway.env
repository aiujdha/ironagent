# Recommended remote-access settings: keep the Gateway behind HTTPS.
HOME=/home/node
TERM=xterm-256color
TZ=UTC
IRON_AGENT_CONFIG_DIR=/app/ironagent/.ironagent
IRON_AGENT_GATEWAY_BIND=lan
IRON_AGENT_GATEWAY_PORT=18789
IRON_AGENT_GATEWAY_ALLOWED_ORIGINS=["https://control.example.com","http://127.0.0.1:30789","http://localhost:30789"]
